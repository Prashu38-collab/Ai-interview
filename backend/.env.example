# Copy to .env and fill in values. NEVER commit .env.

# --- Database (used by the backend service; docker-compose sets this itself) ---
DATABASE_URL=postgresql+psycopg://prashamsaghimire@localhost:5432/ai_interviewer
# For a quick local run without PostgreSQL: DATABASE_URL=sqlite:///./dev.db

# --- Security ---
SECRET_KEY=generate-a-long-random-string

# --- LLM provider ---
# mock      -> deterministic offline service (no API key needed, default)
# openai    -> real OpenAI-compatible API (works with OpenAI, OpenRouter, LM Studio...)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
